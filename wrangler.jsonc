{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "kripto-sinyal",
  "main": "./worker/index.js",
  "compatibility_date": "2026-10-06",
  "assets": {
    "directory": "./site",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },
  "kv_namespaces": [
    {
      "binding": "SIGNALS",
      "id": "3192acf5f06345dca94c01c346440012"
    }
  ]
}
